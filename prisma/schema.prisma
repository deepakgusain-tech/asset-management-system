model User {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String?
  email         String    @unique(map: "user_email_idx")
  emailVerified DateTime?
  image         String?
  password      String
  createdAt     DateTime  @default(now()) @db.Timestamp(6)
  updatedAt     DateTime  @updatedAt @db.Timestamp(6)
  status        Status    @default(ACTIVE)
  roleId        String    @db.Uuid
  accounts      Account[]
  sessions      Session[]
  role          Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
}

model Account {
  userId            String   @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @db.Timestamp(6)
  updatedAt         DateTime @updatedAt @db.Timestamp(6)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String   @db.Uuid
  expires      DateTime
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime @updatedAt @db.Timestamp(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique(map: "role_name_idx")
  description String
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @db.Timestamp(6)
  status      Status   @default(ACTIVE)
  module      Module[]
  user        User[]
}

model Module {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique(map: "module_name_idx")
  description String
  roleId      String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @db.Timestamp(6)
  status      Status   @default(ACTIVE)
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
}

model DeviceCategory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique(map: "device_category_name_idx")
  description String
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now()) @db.Timestamp(6)
  updatedAt   DateTime @updatedAt @db.Timestamp(6)
  device      Device[]
}

model Device {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  serialNumber String           @unique
  description  String?
  status       DeviceStatus     @default(ACTIVE)
  categoryId   String           @db.Uuid
  manufacturer String?
  model        String?
  purchaseDate DateTime?
  warrantyEnd  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  category     DeviceCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  device       DeviceAssigned[]

  @@index([categoryId])
  @@index([status])
}

model Department {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String     @unique(map: "department_name_idx")
  description String
  status      Status     @default(ACTIVE)
  createdAt   DateTime   @default(now()) @db.Timestamp(6)
  updatedAt   DateTime   @updatedAt @db.Timestamp(6)
  employee    Employee[]
}

model Location {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String     @unique(map: "location_name_idx")
  streetAddress String
  city          String
  state         String
  postalCode    String
  country       String
  latitude      String?
  longitude     String?
  status        Status     @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  employee      Employee[]

  @@index([status])
}

model Employee {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  first_name   String
  last_name    String           @unique
  email        String?
  phoneNumber  String?
  dateOfBirth  DateTime?
  hireDate     DateTime?
  salary       String
  status       Status           @default(ACTIVE)
  departmentId String           @db.Uuid
  locationId   String           @db.Uuid
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  device       DeviceAssigned[]
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  location     Location         @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([departmentId])
  @@index([locationId])
  @@index([status])
}

model DeviceAssigned {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assignedDate DateTime             @default(now()) @db.Timestamp(6)
  returnedDate DateTime?            @default(now()) @db.Timestamp(6)
  status       AssignedDeviceStatus @default(NOTASSIGNED)
  remarks      String
  deviceId     String               @db.Uuid
  employeeId   String               @db.Uuid
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  device       Device               @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee     Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([employeeId])
}
